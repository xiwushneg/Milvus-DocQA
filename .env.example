# ============ 环境变量示例：复制为 .env 或 export 到 shell ============

# Embedding API Key（provider=api 时必填，如 SiliconFlow https://siliconflow.cn）
EMBEDDING_API_KEY=

# 大模型 API Key（Ollama / vLLM 本地部署可留空）
LLM_API_KEY=

# 以下均可选，留空则使用 config/config.yaml 中的默认值
# DOCQA_MILVUS_URI=./data/milvus_docqa.db        # 或 http://localhost:19530
# DOCQA_EMBEDDING_PROVIDER=local                 # local | api | mock
# DOCQA_LLM_BASE_URL=http://localhost:11434/v1   # Ollama；vLLM/API 换对应地址
# DOCQA_LLM_MODEL=qwen2.5:7b                     # Qwen/Qwen2.5-7B-Instruct 等
